[Unit]
Description=ShinyHub - self-hosted Shiny app platform
After=network-online.target
Wants=network-online.target

[Service]
# The stable supervisor remains systemd's direct child across every handoff.
# Ready server children notify MAINPID=<supervisor>; the supervisor watches the
# active server's PID file through Linux pidfds, including non-child processes.
# Requires Linux 5.3+. NotifyAccess=all permits readiness from server children.
Type=notify
NotifyAccess=all
User=shinyhub
Group=shinyhub
# Never put secret values in Environment= lines: this unit is world-readable.
# Optional root-owned 0600 environment file, read by the system service manager:
# EnvironmentFile=/etc/shinyhub/shinyhub.env
# Prefer auth.secret_file for the root secret. Protect shinyhub.yaml with 0600
# when it contains other secrets. Native apps still share this service's UID;
# private files and environment files do not isolate them from the server.
RuntimeDirectory=shinyhub
RuntimeDirectoryMode=0700
# shinyhub.yaml must set: server.pid_file: /run/shinyhub/shinyhub.pid
ExecStart=/usr/local/bin/shinyhub serve --supervise --config /etc/shinyhub/shinyhub.yaml
# Zero-downtime upgrade: drop a new /usr/local/bin/shinyhub binary, then
# `systemctl reload shinyhub`. The command waits for temporary app transitions
# and exits successfully only when a successor acknowledges readiness. Rejected
# reloads and failed handoffs make systemctl reload fail while apps keep serving.
ExecReload=/usr/local/bin/shinyhub reload --config /etc/shinyhub/shinyhub.yaml --wait 10m --output table
# server.pid_file identifies the ACTIVE SERVER, not systemd MAINPID.
# Do not set PIDFile= here: systemd must keep tracking the stable supervisor.
GuessMainPID=no
KillMode=control-group
# Allow transition wait, startup acknowledgement, and fresh readiness budget.
# Increase with --wait or upgrade_timeout: wait + 2*upgrade_timeout + 75s.
TimeoutStartSec=14min

# An unexpected active-server exit makes the supervisor fail, so systemd sees
# a genuine child exit and restarts the unit even when retired relays remain.
# Full service stops kill this cgroup. Broker workers live in separate units.
Restart=on-failure
RestartSec=5s
# Exit 7 means the database was migrated by a NEWER shinyhub build, so this
# binary refuses to serve it. Retrying cannot fix that, and without this line
# the unit sits in "activating (auto-restart)" forever - which reads as healthy
# to most monitoring - while the service is in fact down. Stopping puts the unit
# in "failed" so the alert fires and `journalctl -u shinyhub` shows the reason.
RestartPreventExitStatus=7

# Raise the file-descriptor limit well above the default 1024: each proxied
# WebSocket session holds client+backend sockets, plus DB connections and app
# log files, so a busy fleet can exhaust the default and fail accept().
LimitNOFILE=65536

# Defense in depth. These are safe for the control plane AND the operator app
# processes it spawns (which still need to write to the data dir and install
# dependencies):
#   NoNewPrivileges  - apps never need privilege escalation.
#   PrivateTmp       - per-service /tmp.
#   ProtectSystem=full - /usr, /boot, /etc become read-only (config is read-only;
#                      data under /var or a dedicated dir stays writable).
#   ProtectKernelTunables / RestrictSUIDSGID - apps don't tune the kernel or
#                      create setuid files.
# Deliberately NOT set: ProtectControlGroups (native-mode warm-wake manages
# cgroups) and ProtectSystem=strict (app processes must write the data dir);
# both would break working deployments.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
RestrictSUIDSGID=true

# Delegate the cpu, memory and pids controllers so the process can manage
# per-app cgroup v2 subtrees. Native-mode resource limits (per-app memory.max /
# cpu.max), the per-replica pids.max fork-bomb cap, and warm-wake memory reclaim
# require this. Without a given controller the corresponding feature degrades to
# no enforcement (logged) and apps run uncapped on that dimension: omitting pids
# leaves every replica able to exhaust the host PID table.
Delegate=cpu memory pids

[Install]
WantedBy=multi-user.target
